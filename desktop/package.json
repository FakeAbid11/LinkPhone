{
  "name": "linkphone-desktop",
  "productName": "LinkPhone",
  "version": "0.1.3",
  "private": true,
  "description": "LinkPhone - your Android phone, on your PC. LAN only.",
  "author": "LinkPhone <dev@linkphone.dev>",
  "homepage": "https://github.com/FakeAbid11/linkphone",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage deb --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "electron-updater": "^6.8.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.1",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "dev.linkphone.desktop",
    "productName": "LinkPhone",
    "artifactName": "${productName}.Setup.${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "artifactName": "${productName}.Setup.${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "maintainer": "LinkPhone <dev@linkphone.dev>",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FakeAbid11",
        "repo": "linkphone"
      }
    ]
  }
}
