{
  "name": "linkphone-desktop",
  "version": "0.8.0",
  "private": true,
  "description": "LinkPhone desktop companion for Android",
  "author": "FakeAbid11",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','release','test-results','playwright-report'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dist:win": "electron-builder --win portable nsis --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "bonjour-service": "1.3.0",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "20.17.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "playwright": "1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
